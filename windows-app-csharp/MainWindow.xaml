<Window x:Class="FontInstaller.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Font Installer" Width="680" Height="480" MinWidth="620" MinHeight="430" FontFamily="Segoe UI" Background="#1E1E1E" Foreground="#F2F2F2">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#343434"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#4B4B4B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0E639C"/><Setter Property="BorderBrush" Value="#0E639C"/><Setter Property="Padding" Value="16,7"/></Style>
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#B8B8B8"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#343434"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#555555"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#252526"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#252526"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowBackground" Value="#252526"/><Setter Property="AlternatingRowBackground" Value="#2A2A2B"/><Setter Property="GridLinesVisibility" Value="None"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Font Installer" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Grid.Row="1" Background="#343434" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Center" Padding="2"><StackPanel Orientation="Horizontal"><Button x:Name="SegmentInstall" Style="{StaticResource SegmentButton}" Content="From Folder/Zip" Click="ShowInstall"/><Button x:Name="SegmentGoogle" Style="{StaticResource SegmentButton}" Content="Google Fonts" Click="ShowGoogle"/><Button x:Name="SegmentFontsource" Style="{StaticResource SegmentButton}" Content="Fontsource" Click="ShowFontsource"/><Button x:Name="SegmentLibrary" Style="{StaticResource SegmentButton}" Content="Installed" Click="ShowLibrary"/></StackPanel></Border>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid x:Name="InstallPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="50"/><RowDefinition Height="30"/></Grid.RowDefinitions><Button Grid.Row="0" x:Name="SourceButton" Content="↓&#x0a;&#x0a;Click to choose, or drag a folder or .zip file here" FontSize="14" Background="#252526" Foreground="#B8B8B8" BorderBrush="#777777" BorderThickness="2" Click="ChooseSource"/><DockPanel Grid.Row="1" VerticalAlignment="Center"><CheckBox x:Name="OverwriteCheck" Content="Overwrite existing fonts" VerticalAlignment="Center" Foreground="#E5E5E5"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="⚙" ToolTip="Settings" Click="Settings" Margin="0,0,8,0"/><Button Content="Check for updates" Click="CheckUpdates" Margin="0,0,8,0"/><Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install" IsEnabled="False" Click="InstallLocal"/></StackPanel></DockPanel><TextBlock Grid.Row="2" x:Name="InstallStatus" Foreground="#B8B8B8" VerticalAlignment="Center"/></Grid>
      <Grid x:Name="CatalogPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><Button Content="Load catalog" Click="LoadCatalog" DockPanel.Dock="Right"/><TextBox x:Name="SearchBox" Margin="0,0,8,0" TextChanged="FilterCatalog"/><TextBlock x:Name="CatalogLink" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel><ListBox x:Name="FamiliesList" Grid.Row="1" Margin="0,6,0,8" SelectionMode="Extended"/><Border Grid.Row="2" BorderBrush="#454545" BorderThickness="0,1,0,0" Padding="0,10,0,0"><DockPanel><Button x:Name="CatalogInstallButton" Style="{StaticResource PrimaryButton}" Content="Install selected" IsEnabled="False" Click="InstallCatalog" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><TextBlock Text="Weights" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="WeightsBox" Text="400,700" Width="115"/><CheckBox x:Name="ItalicCheck" Content="Italic" Margin="15,0,0,0" VerticalAlignment="Center"/><CheckBox x:Name="CatalogOverwriteCheck" Content="Overwrite existing fonts" Margin="15,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel></Border></Grid>
      <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><Button Content="Open Fonts Folder" Click="OpenFonts" DockPanel.Dock="Right"/><Button Content="Refresh" Click="RefreshLibrary" DockPanel.Dock="Right" Margin="0,0,8,0"/><TextBlock Text="Installed Fonts" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="LibraryCount" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel><DataGrid x:Name="FontsGrid" Grid.Row="1" Margin="0,4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Font file" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Uninstall Selected" Click="UninstallSelected" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready." Foreground="#A9A9A9" VerticalAlignment="Bottom"/>
  </Grid>
</Window>
